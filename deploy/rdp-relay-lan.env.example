# rdp-relay の LAN 用インスタンス (rdp-relay-lan.service, --auth vpc) の設定。
#
#   install: sudo install -m 600 -o root -g root rdp-relay-lan.env.example \
#              /etc/ichibanboshi/rdp-relay-lan.env
#
# cf-access 側 (rdp-relay.env) と違い Cloudflare の secret は要らない。
# vpc モードは Access 検証をしない — 認証は「LAN に届くこと」+ RDS の NLA。

# 待ち受けアドレス。**必須** (未設定だと既定 127.0.0.1:3390 が cf-access 側の口と
# 紛れるため、service は env ファイルが無ければ起動しない)。
# 社内 nginx (ohishi-dev) の proxy_pass から届くアドレスにする。
RDP_RELAY_BIND=172.18.21.35:3391

# --- `/defaults` が画面に配る値 (cf-access 側と同じ意味) ---

# Windows のドメイン。
RDP_RELAY_DEFAULT_DOMAIN=OHISHI

# publish 済み RemoteApp のエイリアス。例: ||CAPE_UNYU (空ならフルデスクトップ)
RDP_RELAY_DEFAULT_REMOTE_APP=

# nginx が同一オリジンで /rdp /defaults を proxy するなら CORS は不要 (未設定のまま)。
# ビューアを別オリジンから直結させる場合だけ、その origin を書く。
#RDP_RELAY_CORS_ORIGIN=
