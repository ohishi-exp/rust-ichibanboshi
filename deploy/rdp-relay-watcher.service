[Unit]
Description=Restart rdp-relay after binary update

[Service]
Type=oneshot
# scp → mv の直後に走らないよう少し待つ (ichibanboshi-watcher.service と同じ型)。
ExecStartPre=/bin/sleep 2
ExecStart=/bin/systemctl restart rdp-relay
# LAN 用インスタンス (rdp-relay-lan) も同じ binary なので一緒に上げ直す。
# 未設置のホストでは失敗してよい (`-` で無視)。try-restart なので停止中なら触らない。
ExecStart=-/bin/systemctl try-restart rdp-relay-lan
